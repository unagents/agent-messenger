# systemd user unit for the agent-messenger broker.
#
# Install (on the broker host, as the user that owns the checkout):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/agent-messenger-broker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now agent-messenger-broker.service
#   loginctl enable-linger $USER   # keep it running without a login session
#
# Runs through the loader: npx fetches @unagents/messenger (Verdaccio),
# which fetches @unagents/messenger-core (Gitea Packages). Adjust the npx
# path if it differs on the host (`which npx`).

[Unit]
Description=agent-messenger broker (Claude Code session messaging)
After=network.target

[Service]
Environment=AGENT_MESSENGER_BIND=0.0.0.0
Environment=AGENT_MESSENGER_PORT=7901
# Environment=AGENT_MESSENGER_TOKEN=<token>
# Permanent-broker mesh: other permanent brokers are found by UDP discovery; enable
# Environment=AGENT_MESSENGER_MESH=on
ExecStart=/usr/bin/npx -y @unagents/messenger broker
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
