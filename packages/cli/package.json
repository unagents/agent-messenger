{
  "name": "@unagents/messenger",
  "version": "0.11.1",
  "description": "agent-messenger CLI: fetches the broker / client packages from Gitea Packages, caches them and runs them.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/unagents/agent-messenger.git",
    "directory": "packages/cli"
  },
  "bin": {
    "agent-messenger": "./dist/main.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsgo -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@unagents/messenger-protocol": "0.11.1"
  }
}
